# 统一换行符为 LF（Windows 上 git 不再对每个文件刷 warning）
* text=auto eol=lf

# 源码按文本处理
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.ui    text eol=lf
*.pro   text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.bat   text eol=crlf
*.sln   text eol=crlf
*.vcxproj text eol=crlf

# 二进制文件不做换行符转换
*.png   binary
*.jpg   binary
*.bar   binary
*.mod   binary
*.lib   binary
*.dll   binary
*.exe   binary
